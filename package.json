{
  "name": "FieldKit",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "lint:ci": "biome ci --error-on-warnings .",
    "format:check": "biome format .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "prepare": "node .husky/install.mjs",
    "branch:check": "node scripts/check-branch.mjs",
    "test:tooling": "node --test scripts/git-workflow.test.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
