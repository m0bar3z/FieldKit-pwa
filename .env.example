SESSION_SECRET=

# Generate a matching key pair: pnpm exec web-push generate-vapid-keys
# Public key is embedded at build time; rebuild after changing it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real contact, e.g. mailto:you@example.com (not a localhost URL).
VAPID_SUBJECT=
# Generate independently, e.g. openssl rand -hex 32. Keep it server-only.
TASK_REMINDER_CRON_SECRET=
# Used only by pnpm reminders:run. HTTPS required except on localhost.
TASK_REMINDER_ORIGIN=http://localhost:3000
